{
  "base_url": "http://localhost:8080",
  "auth": {
    "type": "bearer",
    "header": "Authorization: Bearer <access_token>"
  },
  "endpoints": [
    {
      "name": "Health check",
      "method": "GET",
      "path": "/health",
      "auth_required": false,
      "request": {
        "headers": {}
      },
      "responses": {
        "200": {
          "body": {
            "status": "ok",
            "message": "Server is running!"
          }
        }
      }
    },
    {
      "name": "Send email OTP",
      "method": "POST",
      "path": "/api/v1/auth/email/send",
      "auth_required": false,
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "user@example.com"
        }
      },
      "responses": {
        "200": {
          "body": {
            "message": "OTP код отправлен на ваш email"
          }
        },
        "400": {
          "body": {
            "error": "укажите корректный email"
          }
        },
        "500": {
          "body": {
            "error": "не удалось отправить OTP код"
          }
        }
      }
    },
    {
      "name": "Verify email OTP",
      "method": "POST",
      "path": "/api/v1/auth/email/verify",
      "auth_required": false,
      "request": {
        "headers": {
          "Content-Type": "application/json",
          "User-Agent": "Mozilla/5.0"
        },
        "body": {
          "email": "user@example.com",
          "code": "123456"
        }
      },
      "responses": {
        "200": {
          "body": {
            "access_token": "<jwt_access_token>",
            "refresh_token": "<jwt_refresh_token>"
          }
        },
        "400": {
          "body": {
            "error": "email и code обязательны"
          }
        },
        "401": {
          "body": {
            "error": "неверный или истекший OTP код"
          }
        }
      }
    },
    {
      "name": "Init Telegram auth",
      "method": "POST",
      "path": "/api/v1/auth/telegram/init",
      "auth_required": false,
      "request": {
        "headers": {}
      },
      "responses": {
        "200": {
          "body": {
            "auth_token": "d7c6c4b3-1111-2222-3333-444455556666",
            "deep_link": "https://t.me/<bot_username>?start=d7c6c4b3-1111-2222-3333-444455556666"
          }
        },
        "500": {
          "body": {
            "error": "не удалось инициализировать авторизацию"
          }
        }
      }
    },
    {
      "name": "Check Telegram auth status",
      "method": "GET",
      "path": "/api/v1/auth/telegram/check",
      "auth_required": false,
      "request": {
        "headers": {},
        "query": {
          "auth_token": "d7c6c4b3-1111-2222-3333-444455556666"
        }
      },
      "responses": {
        "200_pending": {
          "body": {
            "status": "pending"
          }
        },
        "200_approved": {
          "body": {
            "status": "approved",
            "tokens": {
              "access_token": "<jwt_access_token>",
              "refresh_token": "<jwt_refresh_token>"
            }
          }
        },
        "400": {
          "body": {
            "error": "параметр auth_token обязателен"
          }
        },
        "401": {
          "body": {
            "error": "сессия не найдена или истекла"
          }
        }
      }
    },
    {
      "name": "Get current user profile",
      "method": "GET",
      "path": "/api/v1/users/me",
      "auth_required": true,
      "request": {
        "headers": {
          "Authorization": "Bearer <access_token>"
        }
      },
      "responses": {
        "200": {
          "body": {
            "id": 1,
            "email": "user@example.com",
            "email_verified": true,
            "telegram_id": null,
            "telegram_username": null,
            "first_name": "Ivan",
            "is_onboarded": true,
            "role": "user",
            "is_active": true,
            "created_at": "2026-09-05T10:00:00Z",
            "updated_at": "2026-09-05T10:05:00Z"
          }
        },
        "401": {
          "body": {
            "error": "неавторизован"
          }
        },
        "404": {
          "body": {
            "error": "пользователь не найден"
          }
        }
      }
    },
    {
      "name": "Complete onboarding",
      "method": "POST",
      "path": "/api/v1/users/me/onboarding",
      "auth_required": true,
      "request": {
        "headers": {
          "Authorization": "Bearer <access_token>",
          "Content-Type": "application/json"
        },
        "body": {
          "first_name": "Ivan"
        }
      },
      "responses": {
        "200": {
          "body": {
            "id": 1,
            "email": "user@example.com",
            "email_verified": true,
            "telegram_id": null,
            "telegram_username": null,
            "first_name": "Ivan",
            "is_onboarded": true,
            "role": "user",
            "is_active": true,
            "created_at": "2026-09-05T10:00:00Z",
            "updated_at": "2026-09-05T10:10:00Z"
          }
        },
        "400": {
          "body": {
            "error": "имя не может быть пустым"
          }
        },
        "401": {
          "body": {
            "error": "неавторизован"
          }
        }
      }
    },
    {
      "name": "Update profile",
      "method": "PATCH",
      "path": "/api/v1/users/me",
      "auth_required": true,
      "request": {
        "headers": {
          "Authorization": "Bearer <access_token>",
          "Content-Type": "application/json"
        },
        "body": {
          "first_name": "Ivan Updated"
        }
      },
      "responses": {
        "200": {
          "body": {
            "id": 1,
            "email": "user@example.com",
            "email_verified": true,
            "telegram_id": null,
            "telegram_username": null,
            "first_name": "Ivan Updated",
            "is_onboarded": true,
            "role": "user",
            "is_active": true,
            "created_at": "2026-09-05T10:00:00Z",
            "updated_at": "2026-09-05T10:15:00Z"
          }
        },
        "400": {
          "body": {
            "error": "имя не может быть пустым"
          }
        },
        "401": {
          "body": {
            "error": "неавторизован"
          }
        }
      }
    },
    {
      "name": "Protected profile test route",
      "method": "GET",
      "path": "/api/v1/profile",
      "auth_required": true,
      "request": {
        "headers": {
          "Authorization": "Bearer <access_token>"
        }
      },
      "responses": {
        "200": {
          "body": {
            "message": "Доступ разрешен!",
            "user_id": 1,
            "role": "user"
          }
        }
      }
    }
  ],
  "common_errors": [
    {
      "status": 400,
      "body": {
        "error": "некорректный формат данных"
      }
    },
    {
      "status": 401,
      "body": {
        "error": "неавторизован"
      }
    },
    {
      "status": 500,
      "body": {
        "error": "внутренняя ошибка сервера"
      }
    }
  ],
  "notes": [
    "Для защищенных эндпоинтов нужен заголовок Authorization: Bearer <access_token>.",
    "access_token живет 15 минут, refresh_token живет 30 дней.",
    "В ответах user поля email, telegram_id, first_name и telegram_username могут быть null.",
    "Telegram auth сначала возвращает pending, а после подтверждения в боте возвращает tokens."
  ]
}
